<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>cheese</name>
  <version>0.1.1</version>
  <description>Trigger-based image capture node for raw and compressed camera topics.</description>
  <maintainer email="makubex49@gmail.com">Howard</maintainer>
  <license>MIT</license>

  <url type="website">https://github.com/HowardWhile/ros2_cheese</url>
  <url type="repository">https://github.com/HowardWhile/ros2_cheese.git</url>
  <url type="bugtracker">https://github.com/HowardWhile/ros2_cheese/issues</url>
  <author email="makubex49@gmail.com">Howard</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>cheese_interfaces</depend>
  <depend>cv_bridge</depend>
  <depend>libopencv-dev</depend>
  <depend>nlohmann-json-dev</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
